rules_version = '2';

// Aturan keamanan database (Firestore) untuk Tugasku dan Catatan Uang.
// Prinsip: setiap akun hanya boleh membaca & mengubah dokumennya sendiri,
// dan bentuk datanya dibatasi. Selain itu, semua akses ditolak.
service cloud.firestore {
  match /databases/{database}/documents {

    function pemilik(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function bentukBenar(maks) {
      let d = request.resource.data;
      return d.keys().hasOnly(['data', 'diubah', 'versi'])
        && d.keys().hasAll(['data', 'diubah', 'versi'])
        && d.data is string && d.data.size() <= maks
        && d.diubah is int && d.versi == 1;
    }

    // Tugasku
    match /pengguna/{uid} {
      allow get, delete: if pemilik(uid);
      allow create, update: if pemilik(uid) && bentukBenar(500000);
    }

    // Catatan Uang
    match /catatanUang/{uid} {
      allow get, delete: if pemilik(uid);
      allow create, update: if pemilik(uid) && bentukBenar(800000);
    }
    // "list" (melihat daftar semua dokumen) sengaja tidak diizinkan

    // Semua koleksi lain: tertutup
    match /{dokumen=**} {
      allow read, write: if false;
    }
  }
}
